node_modules/
dist/
.next/
coverage/

.env
.env.local
.env*.local

*.tsbuildinfo
*.log
.DS_Store

# Locally-installed agent skills (emilkowalski/skills etc.) — run entirely
# on-disk, never need to be committed for Claude Code to use them.
.agents/
.claude/skills/
skills-lock.json

# Wayfinder maps and scratch notes — working artifacts, not team-facing.
.scratch/

# The designer's handoff prototype: a reference to look at, not a repo artifact.
# ADR 0009 cites it by description rather than by path for this reason.
design_handoff_foodnote/

# End-to-end suite artifacts — the run's seeded identities and captured
# sessions, plus Playwright's own output. All regenerated per run.
e2e/.auth/
e2e/test-results/
e2e/playwright-report/
# Editor-local Claude Code config. `settings.local.json` is tracked on purpose —
# it is the project's own; `launch.json` is one machine's run configuration.
.claude/launch.json
