# Backend
PORT=3001

# Auth (JWT) — override the dev defaults in any real deployment
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://foodnote:foodnote@localhost:5432/foodnote

# Rate limiting — how many proxies sit in front of the API. 0 = none (local).
# Behind Render (Cloudflare + load balancer) this MUST match the real chain, or
# per-IP limits break: too low and every request resolves to the load balancer's
# address, putting all users in one bucket. Measure it, don't guess — deploy once
# with LOG_CLIENT_IP=true and read the logged X-Forwarded-For chain.
TRUST_PROXY_HOPS=0
LOG_CLIENT_IP=false

# Frontend dev server — where the Next.js proxy forwards /api/* requests
API_URL=http://localhost:3001

# OpenAI — powers POST /meals/ai-parse (#38). Server-side only: never prefix it
# with NEXT_PUBLIC_, or the key ships to the browser. Read at boot with
# getOrThrow, so the API will not start without it — set it on Render too.
# Project-scoped key from platform.openai.com/api-keys; shown only once.
OPENAI_API_KEY=sk-proj-replace-me

# Demo account (#42) — optional, only read by `npm run seed -w backend`.
# Defaults below if unset; override before seeding a real, shared environment.
SEED_DEMO_EMAIL=demo@foodnote.app
SEED_DEMO_PASSWORD=FoodNoteDemo!2026
